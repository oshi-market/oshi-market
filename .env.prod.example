# 배포 서버에서 이 파일을 .env.prod로 복사해 값을 채운다 (.env.prod는 git에 올리지 않음).
DB_NAME=oshimarket
DB_USERNAME=oshimarket
# 로컬 기본값(oshimarket)과 다른 긴 값으로
DB_PASSWORD=
# 32바이트 이상 무작위 값. 만드는 법: openssl rand -base64 48
JWT_SECRET=
# Cloudinary 대시보드 > Settings > API Keys
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Cloudflare Zero Trust > Networks > Tunnels > 터널 선택 > Docker 설치 명령의 --token 값
TUNNEL_TOKEN=
