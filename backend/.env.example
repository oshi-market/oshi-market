# 이 파일을 복사해서 backend/.env 로 만들고 값을 채운다 (.env는 git에 올라가지 않음).

# 필수. JWT 서명 키이며, 없으면 서버가 뜨지 않는다. 각자 아래 명령으로 만든 값을 넣고 다른 사람과 공유하지 않는다.
#   openssl rand -base64 48
JWT_SECRET=

# Cloudinary 대시보드 > Settings > API Keys 의 API Key / API Secret / Cloud name
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
